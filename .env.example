# ─── Solana ────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_CLUSTER=devnet
PLATFORM_AUTHORITY_KEYPAIR=./keys/platform-authority.json
PROGRAM_ID_ESCROW=kH4G28phYLsi8FsJouSLBUbNhyxDeXVmvVYZ1GuZgUc
PROGRAM_ID_ROLLUP=2RU1h2nvcXK972kwfoAdEwCDpJ5xxH9KDM2h5geEHbLd
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ─── MagicBlock Ephemeral Rollups ──────────────────────────────────────────
MAGICBLOCK_RPC_URL=https://devnet.magicblock.app
MAGICBLOCK_WS_URL=wss://devnet.magicblock.app
EPHEMERAL_ROLLUP_VALIDATOR=

# ─── Light Protocol ────────────────────────────────────────────────────────
LIGHT_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
LIGHT_MERKLE_TREE_PUBKEY=
LIGHT_NULLIFIER_QUEUE_PUBKEY=

# ─── Backend HTTP server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_PUBLIC_URL=http://localhost:8080
RUST_LOG=info,backend=debug,tower_http=debug

# ─── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://veranda:veranda@localhost:5432/veranda

# ─── Privy (wallet login) ───────────────────────────────────────────────────
# Frontend: NEXT_PUBLIC_PRIVY_APP_ID (same value as PRIVY_APP_ID).
# Dashboard → enable "Wallet" + Solana external wallets (Phantom, etc.).
#
# Backend production session:
#   PRIVY_VERIFICATION_KEY = PEM from Privy Dashboard (App settings → Verification key).
#   PRIVY_APP_ID / PRIVY_APP_SECRET = Basic auth for api.privy.io user lookup.
# If PRIVY_VERIFICATION_KEY is unset, backend stays in dev stub mode.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=

# ─── LI.FI ─────────────────────────────────────────────────────────────────
LIFI_API_KEY=
LIFI_INTEGRATOR=veranda
NEXT_PUBLIC_LIFI_INTEGRATOR=veranda

# ─── OpenAI (via rig) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── x402 ──────────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_TREASURY_WALLET=
X402_PRICE_AGENT_MATCH_USDC=10000     # 0.01 USDC (6 decimals)
X402_PRICE_DISCLOSURE_USDC=2000000    # 2.00 USDC

# ─── ROS bridge ────────────────────────────────────────────────────────────
ROSBRIDGE_WS_URL=ws://localhost:9090
CEREMONY_RECORDING_PATH=/tmp/match_ceremony.mp4

# ─── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID_ESCROW=kH4G28phYLsi8FsJouSLBUbNhyxDeXVmvVYZ1GuZgUc
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_LIFI_TO_CHAIN=1151111081099710     # CAIP-2 numeric for Solana
