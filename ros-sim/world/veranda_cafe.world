<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="veranda_cafe">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Standard TurtleBot3 world walls -->
    <include>
      <uri>model://turtlebot3_world</uri>
    </include>

    <!-- Cafe table the bot drives to -->
    <include>
      <uri>model://cafe_table</uri>
      <pose>1.5 0 0 0 0 0</pose>
      <name>cafe_table</name>
    </include>

    <!-- Flower atop the table (model from gazebo_models if available) -->
    <include>
      <uri>model://flower</uri>
      <pose>1.5 0 0.78 0 0 0</pose>
      <name>match_flower</name>
    </include>

    <gui>
      <camera name="user_camera">
        <pose>3 -3 3 0 0.7 2.4</pose>
      </camera>
    </gui>
  </world>
</sdf>
